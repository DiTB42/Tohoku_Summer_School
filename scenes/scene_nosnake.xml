<mujoco model="snake scene (no snake)">
  <!-- Snake-free base scene for the multi-snake swarm visualization
       (swarm_core.py). This is scenes/scene.xml WITHOUT the
       <include file="snake.xml"/>: swarm_core injects N name-prefixed snake
       copies itself, so the base must NOT already contain a snake.

       The compiler/option/default blocks below are normally contributed by
       snake.xml through the <include> in scene.xml. They are duplicated here so
       the combined model swarm_core builds matches the physics the policy was
       trained under:
         - compiler angle="radian": the CPG emits joint targets in radians;
           without this MuJoCo would default to degrees and the gait breaks.
         - option integrator="implicitfast": same integrator as training.
         - default geom friction: the snake geoms inherit this friction. -->
  <compiler angle="radian" autolimits="true"/>

  <option integrator="implicitfast"/>

  <default>
    <geom friction="3 0.005 0.0001"/>
  </default>

  <statistic center="0.3 0 0.4" extent="0.8"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.1 0.1 0.1" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>
  </worldbody>

</mujoco>
